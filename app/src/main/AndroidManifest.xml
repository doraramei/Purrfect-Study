<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PurrfectStudy_Anelka">

        <!-- Splash Screen Pembuka -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Layar Login Monokrom Minimalis -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Layar Login Legacy Redirect -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Home -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- Halaman Focus Timer / Group Study -->
        <activity
            android:name=".FocusTimerActivity"
            android:exported="false" />

        <!-- Halaman Statistics -->
        <activity
            android:name=".StatisticsActivity"
            android:exported="false" />

        <!-- Halaman To-Do / Planner -->
        <activity
            android:name=".TodoActivity"
            android:exported="false" />

        <!-- Halaman Calendar -->
        <activity
            android:name=".CalendarActivity"
            android:exported="false" />

        <!-- Halaman Daftar Grup My groups -->
        <activity
            android:name=".GroupsListActivity"
            android:exported="false" />

        <!-- Halaman Detail Grup (Chat & Group Info) -->
        <activity
            android:name=".GroupDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Settings & Profil -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Halaman Studicon Store & Monetisasi -->
        <activity
            android:name=".StudiconStoreActivity"
            android:exported="false" />

    </application>

</manifest>
