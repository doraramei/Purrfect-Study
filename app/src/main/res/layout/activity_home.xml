<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Header Tanggal & Timer Utama -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvDateHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thu, 11/12"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvMainTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00:00"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <!-- Tab Menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Timer"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Books"
            android:gravity="center"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/tvTabStatistics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Statistics"
            android:gravity="center"
            android:textColor="#888888"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- Daftar Subject / Mapel -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:id="@+id/containerSubjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Matematika -->
            <LinearLayout
                android:id="@+id/layoutMatematika"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/ic_play_circle"
                    android:layout_marginEnd="12dp"/>
                <TextView
                    android:id="@+id/tvMatematikaName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Matematika"
                    android:textSize="16sp"
                    android:textColor="#000000" />
                <TextView
                    android:id="@+id/tvMatematikaTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00:00"
                    android:textColor="#666666"
                    android:paddingEnd="12dp"/>
                <TextView
                    android:id="@+id/btnMoreMatematika"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⋮"
                    android:textSize="20sp"
                    android:textColor="#666666"
                    android:paddingHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- 2. Bahasa Indonesia -->
            <LinearLayout
                android:id="@+id/layoutBindo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/ic_play_circle"
                    android:layout_marginEnd="12dp"/>
                <TextView
                    android:id="@+id/tvBindoName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bahasa Indonesia"
                    android:textSize="16sp"
                    android:textColor="#000000" />
                <TextView
                    android:id="@+id/tvBindoTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00:00"
                    android:textColor="#666666"
                    android:paddingEnd="12dp"/>
                <TextView
                    android:id="@+id/btnMoreBindo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⋮"
                    android:textSize="20sp"
                    android:textColor="#666666"
                    android:paddingHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- 3. Bahasa Inggris -->
            <LinearLayout
                android:id="@+id/layoutBing"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/ic_play_circle"
                    android:layout_marginEnd="12dp"/>
                <TextView
                    android:id="@+id/tvBingName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bahasa Inggris"
                    android:textSize="16sp"
                    android:textColor="#000000" />
                <TextView
                    android:id="@+id/tvBingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00:00"
                    android:textColor="#666666"
                    android:paddingEnd="12dp"/>
                <TextView
                    android:id="@+id/btnMoreBing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⋮"
                    android:textSize="20sp"
                    android:textColor="#666666"
                    android:paddingHorizontal="8dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Tombol Tambah Subject -->
            <Button
                android:id="@+id/btnEditSubject"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="+ Edit subject"
                android:textColor="#000000"
                android:backgroundTint="#F2F2F2"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                style="?attr/materialButtonOutlinedStyle" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="To-Do"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calendar"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#888888" />

        <TextView
            android:id="@+id/navGroups"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Groups"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#888888" />
    </LinearLayout>

</LinearLayout>