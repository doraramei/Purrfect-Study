<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnBackStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt;"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Statistics"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default Grayscale"
            android:textSize="12sp"
            android:textColor="#333333"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="#F2F2F2"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- ScrollView dengan scrollbars="none" (Garis scroll dijamin hilang) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        android:fadeScrollbars="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- 1. CARD: Kalender Bulanan & Monthly Log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F9F9F9"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="◄  Nov ▼  2026  ►"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly Log"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Header Hari -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:layout_marginBottom="10dp">
                    <TextView android:text="Mon" android:textSize="12sp" android:textColor="#888888" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" tools:ignore="HardcodedText"/>
                    <TextView android:text="Tue" android:textSize="12sp" android:textColor="#888888" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" tools:ignore="HardcodedText"/>
                    <TextView android:text="Wed" android:textSize="12sp" android:textColor="#888888" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" tools:ignore="HardcodedText"/>
                    <TextView android:text="Thu" android:textSize="12sp" android:textColor="#888888" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" tools:ignore="HardcodedText"/>
                    <TextView android:text="Fri" android:textSize="12sp" android:textColor="#888888" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" tools:ignore="HardcodedText"/>
                    <TextView android:text="Sat" android:textSize="12sp" android:textColor="#888888" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" tools:ignore="HardcodedText"/>
                    <TextView android:text="Sun" android:textSize="12sp" android:textColor="#888888" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:gravity="center" tools:ignore="HardcodedText"/>
                </GridLayout>

                <!-- Grid Kalender -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:layout_marginBottom="14dp">
                    <TextView android:text="1\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="2\n4:43" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="3\n5:13" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="4\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="5\n2:05" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="6\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="7\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>

                    <TextView android:text="8\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="9\n12:10" android:textSize="11sp" android:textColor="#FFFFFF" android:background="#000000" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="10\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="11\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="12\n10:15" android:textSize="11sp" android:textColor="#FFFFFF" android:background="#333333" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="13\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="14\n3:16" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>

                    <TextView android:text="15\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="16\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="17\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:id="@+id/tvCalToday" android:text="18\n0:00" android:textSize="11sp" android:textColor="#FFFFFF" android:background="#000000" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="19\n4:03" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="20\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                    <TextView android:text="21\n-" android:textSize="11sp" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="8dp" tools:ignore="HardcodedText"/>
                </GridLayout>

                <TextView
                    android:id="@+id/tvMonthlyTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nov: 50H 44M"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:gravity="end"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- 2. CARD: Study Breakdown & Ratio (LENGKAP DENGAN DIAGRAM LINGKARAN/DONUT CHART) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F9F9F9"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Study Breakdown &amp; Ratio"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="14dp"
                    tools:ignore="HardcodedText" />

                <!-- Baris 1: Donut Chart Total Waktu & Rincian Mapel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <!-- Donut Chart 1 (Total Waktu di Tengah) -->
                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_donut"
                        android:layout_marginEnd="16dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvDonutTotal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="0:00:00"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            tools:ignore="HardcodedText" />
                    </FrameLayout>

                    <!-- Container Rincian Mapel Dinamis -->
                    <LinearLayout
                        android:id="@+id/containerBreakdown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <!-- Diisi otomatis via Kotlin -->
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginBottom="14dp"/>

                <!-- Baris 2: Donut Chart Rasio (Study / Other) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Donut Chart 2 (Rasio 65/35) -->
                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_donut"
                        android:layout_marginEnd="16dp"
                        android:gravity="center">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="65 / 35"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            tools:ignore="HardcodedText" />
                    </FrameLayout>

                    <!-- Keterangan Rasio -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp">
                            <View android:layout_width="10dp" android:layout_height="10dp" android:background="#000000" android:layout_marginEnd="8dp"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Study" android:textSize="13sp" android:textColor="#000000" tools:ignore="HardcodedText"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15:30 - 65%" android:textSize="12sp" android:textColor="#666666" tools:ignore="HardcodedText"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp">
                            <View android:layout_width="10dp" android:layout_height="10dp" android:background="#CCCCCC" android:layout_marginEnd="8dp"/>
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Other" android:textSize="13sp" android:textColor="#000000" tools:ignore="HardcodedText"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:20 - 35%" android:textSize="12sp" android:textColor="#666666" tools:ignore="HardcodedText"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. CARD: Daily Focus Log & Mascot Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F9F9F9"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:id="@+id/tvDailyDateHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Wed, Nov 18, 2026"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        tools:ignore="HardcodedText" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Focus Log"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <!-- Grid 4 Kotak Stats -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginBottom="12dp">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:background="#FFFFFF" android:padding="12dp" android:layout_margin="3dp">
                        <TextView android:text="Total study time" android:textSize="11sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:ignore="HardcodedText"/>
                        <TextView android:id="@+id/tvStatTotalStudy" android:text="0:00:00" android:textSize="15sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:ignore="HardcodedText"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:background="#FFFFFF" android:padding="12dp" android:layout_margin="3dp">
                        <TextView android:text="Max focus time" android:textSize="11sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:ignore="HardcodedText"/>
                        <TextView android:id="@+id/tvStatMaxFocus" android:text="0:00:00" android:textSize="15sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:ignore="HardcodedText"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:background="#FFFFFF" android:padding="12dp" android:layout_margin="3dp">
                        <TextView android:text="Start time" android:textSize="11sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:ignore="HardcodedText"/>
                        <TextView android:text="AM 7:06" android:textSize="15sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:ignore="HardcodedText"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical" android:background="#FFFFFF" android:padding="12dp" android:layout_margin="3dp">
                        <TextView android:text="End time" android:textSize="11sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:ignore="HardcodedText"/>
                        <TextView android:text="PM 7:03" android:textSize="15sp" android:textStyle="bold" android:textColor="#000000" android:layout_width="wrap_content" android:layout_height="wrap_content" tools:ignore="HardcodedText"/>
                    </LinearLayout>
                </GridLayout>

                <!-- Box Mascot & Jam -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFFFFF"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🐶 📚"
                            android:textSize="32sp"
                            android:layout_marginBottom="6dp"
                            tools:ignore="HardcodedText"/>
                        <TextView
                            android:id="@+id/tvMascotTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00:00"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            tools:ignore="HardcodedText"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stattoon • Dual Mood"
                            android:textSize="10sp"
                            android:textColor="#888888"
                            tools:ignore="HardcodedText"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 4. Detailed Study Timeline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detailed Study Timeline"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="10dp"
                tools:ignore="HardcodedText" />

            <!-- Container Timeline Dinamis -->
            <LinearLayout
                android:id="@+id/containerTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Diisi otomatis via Kotlin -->
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>